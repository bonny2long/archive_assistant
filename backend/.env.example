# Archive Assistant backend settings. Copy to .env.
# Local layout (runbook v12): data in C:/NAS-Local/nas-data, code in C:/Dev/NAS.
DATA_ROOT=C:/NAS-Local/nas-data
INGEST_ROOT=C:/NAS-Local/nas-data/_INGEST/ready
DATABASE_URL=sqlite:///C:/Dev/NAS/archive_assistant/backend/archive_assistant.db

DEBUG=true
DEV_TOOLS_ENABLED=false
API_DOCS_ENABLED=false
ARCHIVE_ASSISTANT_TIMEZONE=America/Chicago

# Pages on other sites cannot approve, move, or change anything. Loopback addresses are
# always allowed. To use the dashboard from a phone or another PC, list its exact address
# here, comma separated (for example http://192.168.1.50:5173).
# ALLOWED_ORIGINS=

# NAS container (planned):
# DATA_ROOT=/app/data
# INGEST_ROOT=/app/data/_INGEST/ready
# DATABASE_URL=sqlite:////app/state/archive_assistant.db   (fast NVMe pool)
